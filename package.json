{
  "name": "omp-agent-skills",
  "version": "0.2.0",
  "private": true,
  "description": "Engineering workflow skills and commands for omp, based on agent-skills.",
  "license": "(MIT AND Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alduraimron/omp-agent-skills.git"
  },
  "homepage": "https://github.com/alduraimron/omp-agent-skills#readme",
  "bugs": {
    "url": "https://github.com/alduraimron/omp-agent-skills/issues"
  },
  "keywords": ["omp-plugin", "omp-package", "agent-skills", "engineering", "workflows"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "LICENSES/",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.json",
    "MODIFICATIONS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MAINTENANCE.md",
    "docs/",
    "skills/",
    "commands/",
    ".omp-plugin/",
    ".claude-plugin/",
    "scripts/",
    "test/",
    "vendor/"
  ],
  "scripts": {
    "check": "node scripts/check-project.mjs && node vendor/agent-skills/scripts/validate-skills.js && node vendor/agent-skills/scripts/validate-reference-links.js",
    "test": "node --test test/*.test.mjs vendor/agent-skills/scripts/lib/skill-lint-test.js vendor/agent-skills/scripts/validate-reference-links-test.js",
    "prepack": "npm run check && npm test"
  }
}
